{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NSAMBO-BACKROOMS",
  "version": "0.3.0-beta.1",
  "identifier": "com.edmundo738.nsambo.backrooms",
  "build": {
    "frontendDist": "../../app/dist"
